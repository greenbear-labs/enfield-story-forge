rules_version = '2';

// Default deny. A user can reach a workspace and everything under it only if
// their uid is in that workspace's memberIds.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(wsId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/workspaces/$(wsId)).data.memberIds;
    }

    // A personal workspace's id is its owner's uid. Checking that first needs no
    // document read, and works before the workspace document has synced (a brand
    // new account, or a first sign-in while offline).
    function ownsPersonal(wsId) {
      return signedIn() && request.auth.uid == wsId;
    }

    match /workspaces/{wsId} {
      // A missing doc reads as null so the app can check whether the personal workspace exists.
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.memberIds);
      // Queries must filter with memberIds array-contains the user's uid.
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Only personal workspaces for now, so nobody can claim another user's id.
      allow create: if ownsPersonal(wsId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Members can update; the owner never changes, and only the owner changes membership.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && (request.resource.data.memberIds == resource.data.memberIds
            || resource.data.ownerId == request.auth.uid);

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // entries, bodies, links, snapshots, and anything added later.
      match /{document=**} {
        allow read, write: if ownsPersonal(wsId) || isMember(wsId);
      }
    }

    // Notes from the "Send feedback" button. Anyone signed in can send one as
    // themselves; only the admin reads them (the Feedback inbox), marks them
    // done, or deletes them.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'adventurebyalex@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /feedback/{feedbackId} {
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'email', 'kind', 'message', 'page', 'device', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.kind in ['problem', 'idea', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.page is string && request.resource.data.page.size() <= 2000
        && request.resource.data.device is string && request.resource.data.device.size() <= 1000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time);
      allow read, update, delete: if isAdmin();
    }

    // Shadow Paths: a story's published copy, which readers play. The author
    // shares it with a link (unlisted), submits it to the library (submitted),
    // or stops sharing it (private). Only the admin puts a story in the library
    // (public); after that, the author's updates keep it there.
    function storyReadable(story) {
      return story.status in ['public', 'unlisted']
        || story.ownerId == request.auth.uid
        || isAdmin();
    }

    function validStory(data) {
      return data.keys().hasOnly(['ownerId', 'ownerName', 'title', 'blurb', 'categories',
            'coverUrl', 'startId', 'state', 'status', 'passageCount', 'endingCount',
            'publishedAt', 'updatedAt'])
        && data.status in ['unlisted', 'submitted', 'public', 'private']
        && data.title is string && data.title.size() <= 500
        && data.ownerName is string && data.ownerName.size() <= 200
        && data.updatedAt == request.time;
    }

    match /published/{storyId} {
      // A missing story reads as null, so the author can check whether it's published.
      allow get: if signedIn() && (resource == null || storyReadable(resource.data));
      // The library queries status == 'public'.
      allow list: if signedIn() && storyReadable(resource.data);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validStory(request.resource.data)
        && (request.resource.data.status != 'public' || isAdmin());
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && validStory(request.resource.data)
        && (isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && (request.resource.data.status != 'public' || resource.data.status == 'public')));
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      // The story is written first, so its passages can check who owns it.
      match /passages/{passageId} {
        allow read: if signedIn()
          && storyReadable(get(/databases/$(database)/documents/published/$(storyId)).data);
        allow write: if signedIn()
          && getAfter(/databases/$(database)/documents/published/$(storyId)).data.ownerId
             == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
